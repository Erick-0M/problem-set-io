# Copy to klc.config.local (gitignored) and fill in. Overrides klc.config.
# Format: KEY=VALUE, one per line, no spaces around '=', no quotes.

# Optional. Plaintext; file is chmod 600 and gitignored. Leave out to be prompted instead.
# Duo, if required, still prompts. Prefer KLC_SSH_KEY.
#KLC_PASSWORD=
KLC_USER=your_netid
KLC_HOST=klc0xxx.quest.northwestern.edu
KLC_SSH_KEY=~/.ssh/id_ed25519
# Optional overrides (defaults: KLC_REMOTE_DIR=<repo name>, relative to your KLC home;
# KLC_DATA_DIR=$KLC_REMOTE_DIR/code/build/input):
#KLC_REMOTE_DIR=
#KLC_DATA_DIR=
