# Shared, non-sensitive KLC defaults (committed). Per-user values go in
# klc.config.local (gitignored), which overrides this file.
# Format: KEY=VALUE, one per line, no spaces around '=', no quotes.

# KLC_REMOTE_DIR (the clone of this repo on KLC) defaults to the repo name, relative to your
# KLC home; KLC_DATA_DIR defaults to $KLC_REMOTE_DIR/code/build/input. Override both in
# klc.config.local if needed.

# JupyterLab on KLC (klc-jupyter.sh)
KLC_JUPYTER_PORT=9002

# Needed to connect / sync files / pull samples (plain SSH, no Slurm)
KLC_HOST=CHANGE_ME_login_host

# Only needed to submit jobs with Slurm; leave commented out otherwise
#SLURM_PARTITION=CHANGE_ME_partition
#SLURM_TIME=02:00:00
#SLURM_MEM=16G
#SLURM_CPUS=4
